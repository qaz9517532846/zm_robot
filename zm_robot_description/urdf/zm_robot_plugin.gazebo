<?xml version="1.0"?>
<robot>
  <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
    <render_engine>ogre2</render_engine>
  </plugin>

  <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

  <sensor type="lidar" name="lidar1">
    <pose relative_to='sick_lidar0'>0 0 0 0 0 0</pose>
    <topic>/sick_lidar1</topic>
    <lidar>
      <scan>
        <horizontal>
          <samples>1440</samples>
          <resolution>1</resolution>
          <min_angle>-2.35619445</min_angle>
          <max_angle>2.35619445</max_angle>
        </horizontal>
      </scan>
        <range>
          <min>0.06</min>
          <max>30</max>
          <resolution>0.001</resolution>
        </range>
      </lidar>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <always_on>1</always_on>
  </sensor>

  <sensor type="lidar" name="lidar1">
    <pose relative_to='sick_lidar1'>0 0 0 0 0 0</pose>
    <topic>/sick_lidar1</topic>
    <lidar>
      <scan>
        <horizontal>
          <samples>1440</samples>
          <resolution>1</resolution>
          <min_angle>-2.35619445</min_angle>
          <max_angle>2.35619445</max_angle>
        </horizontal>
      </scan>
        <range>
          <min>0.06</min>
          <max>30</max>
          <resolution>0.001</resolution>
        </range>
      </lidar>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <always_on>1</always_on>
  </sensor>

  <sensor name="rgbd_camera" type="rgbd_camera">
    <pose relative_to='kinect_v2'>0 0 0 0 0 0</pose>
    <update_rate>15</update_rate>
    <topic>rgbd_camera</topic>
    <camera>
      <horizontal_fov>2.1</horizontal_fov>
      <image>
        <width>1280</width>
        <height>720</height>
      </image>
      <clip>
        <near>0.05</near>
        <far>2.0</far>
      </clip>
    </camera>
  </sensor>

  <sensor name="imu_sensor" type="imu">
    <pose relative_to='IMU_sensor'>0 0 0 0 0 0</pose>
    <always_on>1</always_on>
    <update_rate>20</update_rate>
    <visualize>true</visualize>
    <topic>imu</topic>
  </sensor>
</robot>