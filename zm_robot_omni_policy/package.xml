<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zm_robot_omni_policy</name>
  <version>0.1.0</version>
  <description>Omnidirectional (vx, vy, wz) navigation policy for zm_robot: a SAC residual on top of a frozen X-Mobility base policy, fed by the RGB-D camera, two 2D LiDARs and odometry, run with TensorRT.</description>
  <maintainer email="qaz9517532846@gmail.com">zmtech</maintainer>
  <license>Apache License 2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Optional at run time: zm_robot_navigation (map -> base_link broadcaster used by the launch file). -->
  <!-- Not rosdep keys: TensorRT python bindings and pycuda (pip3 install pycuda). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
